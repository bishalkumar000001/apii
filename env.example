# MongoDB Atlas connection string (required for paid accounts and API keys)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=velocitybots_api

# Generate a random secret of at least 32 characters; keep it private
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=true

# Optional Google Identity Services OAuth web client ID (email/password works without it)
GOOGLE_CLIENT_ID=

# Owner bootstrap: create account using ADMIN_EMAIL, sign in, then call
# POST /api/admin/bootstrap with header X-Admin-Bootstrap-Token. Remove token afterwards.
ADMIN_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-random-token

# Legacy shared API key is disabled by default to enforce paid customer keys.
# Set true only temporarily if you intentionally want to preserve a shared key bypass.
LEGACY_API_KEY_ENABLED=false
API_KEY=

# Existing API settings
COOKIE_URL=
DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=2160
PORT=8000
CONCURRENT_FRAGMENT_DOWNLOADS=15
HTTP_CHUNK_SIZE=10485760
SOCKET_TIMEOUT=15
RETRIES=5
FRAGMENT_RETRIES=5

# Manual payment display on /account (leave blank until your details are ready)
PAYMENT_UPI_ID=
PAYMENT_ACCOUNT_NAME=VelocityBots
PAYMENT_QR_URL=
PAYMENT_INSTRUCTIONS=Pay the exact amount, then submit your transaction reference. Access activates only after manual verification.
